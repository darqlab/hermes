# Hermes config — copy to hermes.yaml and fill in real values.
# Each value can also be set via HERMES_ prefix env vars (e.g. HERMES_SMTP_HOST).

from: ""                 # default envelope/header From for "hermes send"; falls back to smtp.user if unset (or set HERMES_FROM)

smtp:
  host: smtp.example.com
  port: 587
  user: alerts@example.com
  pass: ""              # or set HERMES_SMTP_PASS
  use_tls: false        # direct TLS (port 465)
  starttls: true        # STARTTLS upgrade (port 587)

dkim:
  selector: hermes
  domain: example.com
  key_file: ""          # path to RSA private key PEM file

queue:
  queue_file: hermes_queue.json
  retry_max: 10
  backoff_base: 1s
  backoff_cap: 5m
  worker_tick: 10s

log:
  level: info           # debug, info, warn, error
  format: text          # text, json
